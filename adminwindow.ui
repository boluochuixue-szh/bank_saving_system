   <string notr="true">QWidget {
    background-color: #181A1F;
    color: #E8EAED;
}

QLabel {
    color: #C9CED6;
    font-size: 13px;
}

QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

QLineEdit {
    background-color: #202329;
    color: #F5F7FA;
    border: 1px solid #363B44;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
}

QLineEdit:focus {
    border: 1px solid #1677FF;
}

QComboBox {
    background-color: #202329;
    color: #E8EAED;
    border: 1px solid #363B44;
    border-radius: 7px;
    padding: 5px 10px;
    min-height: 30px;
}

QComboBox:hover {
    border: 1px solid #4A5260;
}

QComboBox:focus {
    border: 1px solid #1677FF;
}

QComboBox QAbstractItemView {
    background-color: #202329;
    color: #E8EAED;
    selection-background-color: #1677FF;
    selection-color: #FFFFFF;
}

QPushButton {
    background-color: #25282E;
    color: #E8EAED;
    border: 1px solid #393E47;
    border-radius: 7px;
    min-height: 36px;
    padding: 4px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #30353D;
    border: 1px solid #1677FF;
}

QPushButton:pressed {
    background-color: #1268D5;
    border: 1px solid #1268D5;
}

QPushButton#showAllButton,
QPushButton#addCustomerButton {
    background-color: #1677FF;
    color: #FFFFFF;
    border: 1px solid #1677FF;
    font-weight: bold;
}

QPushButton#showAllButton:hover,
QPushButton#addCustomerButton:hover {
    background-color: #398BFF;
}

QPushButton#deleteButton {
    background-color: #3A3030;
    color: #FFB4B4;
    border: 1px solid #5A3A3A;
}

QPushButton#deleteButton:hover {
    background-color: #4A3535;
    border: 1px solid #E57373;
}

QPushButton#freezeButton {
    background-color: #34302A;
    color: #FFD591;
    border: 1px solid #5A4A32;
}

QPushButton#freezeButton:hover {
    background-color: #443A2B;
    border: 1px solid #D9A441;
}

QPushButton#unfreezeButton {
    background-color: #29362F;
    color: #A7E3BE;
    border: 1px solid #3D5A49;
}

QPushButton#unfreezeButton:hover {
    background-color: #31483B;
    border: 1px solid #65B88A;
}

QPushButton#exitButton {
    background-color: #25282E;
    color: #AEB5BF;
}

QPushButton#exitButton:hover {
    background-color: #353A42;
    border: 1px solid #7E8793;
}

QTableView {
    background-color: #202329;
    alternate-background-color: #24272D;
    color: #E8EAED;
    gridline-color: #343941;
    border: 1px solid #363B44;
    border-radius: 7px;
    selection-background-color: #1677FF;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #2B2F36;
    color: #F5F7FA;
    border: none;
    border-right: 1px solid #3A3F47;
    border-bottom: 1px solid #3A3F47;
    padding: 7px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #202329;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4A505A;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #626A76;
}</string>
