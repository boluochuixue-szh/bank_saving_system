  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #181A1F;
    color: #FFFFFF;
}

QLabel {
    color: #E8EAED;
}

QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

QLabel#accountLabel {
    color: #9EA6B3;
    font-size: 13px;
}

QPushButton {
    background-color: #24272D;
    color: #F5F7FA;
    border: 1px solid #3A3F47;
    border-radius: 10px;
    font-size: 14px;
    min-height: 52px;
}

QPushButton:hover {
    background-color: #30353D;
    border: 1px solid #1677FF;
}

QPushButton:pressed {
    background-color: #1268D5;
    border: 1px solid #1268D5;
}

QPushButton#depositButton,
QPushButton#withdrawButton,
QPushButton#transferButton {
    background-color: #1677FF;
    border: 1px solid #1677FF;
    font-weight: bold;
}

QPushButton#depositButton:hover,
QPushButton#withdrawButton:hover,
QPushButton#transferButton:hover {
    background-color: #398BFF;
}

QPushButton#reportLossButton {
    background-color: #2B2E34;
}

QPushButton#exitButton {
    background-color: #25282E;
}

QPushButton#reportLossButton:hover,
QPushButton#exitButton:hover {
    border: 1px solid #1677FF;
}

QLabel#accountLabel {
    background-color: #20242B;
    color: #AEB7C4;
    border: 1px solid #343A44;
    border-radius: 8px;
    padding: 6px 16px;
}

QPushButton#reportLossButton {
    background-color: #3A3030;
    color: #FFB4B4;
    border: 1px solid #5A3A3A;
}

QPushButton#reportLossButton:hover {
    background-color: #4A3535;
    border: 1px solid #E57373;
}

QPushButton#reportLossButton:pressed {
    background-color: #5A3030;
}

QPushButton#exitButton {
    background-color: #25282E;
    color: #C8CDD5;
    border: 1px solid #41464F;
}

QPushButton#exitButton:hover {
    background-color: #353A42;
    border: 1px solid #8A929E;
}

QPushButton#exitButton:pressed {
    background-color: #1C1F24;
}</string>
